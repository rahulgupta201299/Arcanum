# ---------------------------------------------------------------
# LibraryVerse configuration. Everything is optional: with no keys
# the app runs fully offline using the built-in rule-based NLU and
# local hashed embeddings over the seed catalog.
# ---------------------------------------------------------------

# LLM provider for the librarian: openai | anthropic | gemini | ollama | rules
LLM_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Embeddings: local | openai | ollama
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# External catalogs ("books from across the internet")
ENABLE_OPEN_LIBRARY=true
ENABLE_GOOGLE_BOOKS=true
# Short Wikipedia answers to general questions when no LLM is configured
ENABLE_WIKIPEDIA=true
GOOGLE_BOOKS_API_KEY=

# Server-side TTS (optional; browser speechSynthesis is used otherwise): browser | openai
TTS_PROVIDER=browser
OPENAI_TTS_MODEL=gpt-4o-mini-tts
